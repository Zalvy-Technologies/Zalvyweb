{
  "ci": {
    "collect": {
      "numberOfRuns": 1,
      "startServerCommand": "node scripts/e2e-server.mjs",
      "startServerReadyPattern": "Ready in",
      "startServerReadyTimeout": 60000,
      "url": [
        "http://localhost:3000",
        "http://localhost:3000/platform",
        "http://localhost:3000/contact",
        "http://localhost:3000/about",
        "http://localhost:3000/verify"
      ]
    },
    "upload": {
      "target": "temporary-public-storage"
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "warn",
          {
            "minScore": 0.8
          }
        ],
        "categories:accessibility": [
          "warn",
          {
            "minScore": 0.9
          }
        ],
        "categories:best-practices": [
          "warn",
          {
            "minScore": 0.9
          }
        ],
        "categories:seo": [
          "warn",
          {
            "minScore": 0.9
          }
        ],
        "largest-contentful-paint": [
          "warn",
          {
            "maxNumericValue": 4000
          }
        ],
        "first-input-delay": [
          "warn",
          {
            "maxNumericValue": 200
          }
        ],
        "cumulative-layout-shift": [
          "warn",
          {
            "maxNumericValue": 0.2
          }
        ],
        "interactive": [
          "warn",
          {
            "maxNumericValue": 5000
          }
        ],
        "total-byte-weight": [
          "warn",
          {
            "maxNumericValue": 2500000
          }
        ],
        "script-bootup-time-is-not-too-long": [
          "warn",
          {
            "maxNumericValue": 1500
          }
        ],
        "mainthread-work-breakdown": [
          "warn",
          {
            "maxNumericValue": 4000
          }
        ],
        "uses-long-cache-ttl": [
          "warn",
          {
            "minScore": 0.8
          }
        ],
        "uses-text-compression": [
          "warn",
          {
            "minScore": 0.8
          }
        ],
        "offscreen-images": [
          "warn",
          {
            "minScore": 0.9
          }
        ],
        "modern-image-formats": [
          "warn",
          {
            "minScore": 0.9
          }
        ],
        "viewport": [
          "warn",
          {
            "minScore": 0.9
          }
        ],
        "document-title": [
          "warn",
          {
            "minScore": 0.9
          }
        ],
        "meta-description": [
          "warn",
          {
            "minScore": 0.9
          }
        ],
        "html-has-lang": [
          "warn",
          {
            "minScore": 0.9
          }
        ],
        "image-alt": [
          "warn",
          {
            "minScore": 0.9
          }
        ]
      }
    }
  }
}